# Pin exact versions on install; never write caret/tilde ranges.
save-exact=true

# Enforce the engines field (Node >= 22).
engine-strict=true

# NOTE: the supply-chain "min release age" gate is NOT set here.
# pnpm reads it from pnpm-workspace.yaml as `minimumReleaseAge` (minutes).
# See pnpm-workspace.yaml.
