# Copy this file to .env.local and fill in your key:
#   cp .env.example .env.local
#
# The API key is server-only — it is never bundled to the browser and never committed.

# Required: your Anthropic API key (https://console.anthropic.com/).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: pin the vision model. Defaults to claude-haiku-4-5-20251001 in code if unset.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
